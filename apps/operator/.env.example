# Copy to .env.local and fill in. Values come from `terraform output` in
# infra/ (operator_user_pool_id, operator_app_client_id, operator_hosted_ui_domain).

COGNITO_OPERATOR_REGION=eu-west-2
COGNITO_OPERATOR_USER_POOL_ID=
COGNITO_OPERATOR_APP_CLIENT_ID=
COGNITO_OPERATOR_DOMAIN=
APP_ORIGIN=http://localhost:3001

# The FastAPI backend origin this app's BFF proxy forwards to.
API_BASE_URL=http://localhost:8000
