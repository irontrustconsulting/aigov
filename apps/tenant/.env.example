# Copy to .env.local and fill in. Values come from `terraform output` in
# infra/ (tenant_user_pool_id, tenant_app_client_id, tenant_hosted_ui_domain).

COGNITO_REGION=eu-west-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_DOMAIN=
APP_ORIGIN=http://localhost:3000

# The FastAPI backend origin this app's BFF proxy forwards to.
API_BASE_URL=http://localhost:8000
