# Copy to .env and adjust. .env is gitignored; this template is committed.

APP_ENV=dev
DEBUG=true

# Database (matches docker-compose Postgres)
DATABASE_URL=postgresql+psycopg://aigov:aigov_dev_password@localhost:5432/aigov

# Object storage — MinIO in dev. For real AWS S3, leave S3_ENDPOINT_URL unset.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_EVIDENCE_BUCKET=aigov-evidence

# Cognito — fill when wiring auth
# COGNITO_REGION=
# COGNITO_USER_POOL_ID=
# COGNITO_APP_CLIENT_ID=
